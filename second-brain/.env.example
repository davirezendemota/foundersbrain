# ============================================
# Variáveis de Ambiente - second-brain-app
# ============================================
# 
# Copie este arquivo para .env e configure os valores
# cp .env.example .env
#

# ============================================
# Database (PostgreSQL)
# ============================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres

# ============================================
# Backend (FastAPI)
# ============================================
# Ambiente: development ou production
ENVIRONMENT=development

# Path prefix para proxy reverso (nginx/traefik)
# Deixe vazio se não estiver usando proxy reverso
BACKEND_API_ROOT_PATH=

# JWT (obrigatório em produção)
JWT_SECRET_KEY=dev-insecure-change-me
JWT_ALGORITHM=HS256

# OpenAI (necessário para testar a conversa com IA)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_WEB_SEARCH_ENABLED=true
OPENAI_WEB_SEARCH_MODEL=gpt-4.1-mini
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=coral

# ============================================
# Frontend (Next.js)
# ============================================
# URL da API como o *navegador* acessa (requisições partem do cliente).
# Com docker compose e portas padrão: http://localhost:10001
# Se acessar o app por IP na rede, use o mesmo host/IP e porta 10001.
# Não use o hostname do serviço Docker (ex.: http://backend:8000).
NEXT_PUBLIC_BACKEND_URL=http://localhost:10001
