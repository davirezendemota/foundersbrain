# Copie para .env na mesma pasta (ou deixe o ./second-brain --setup criar o ficheiro).
# Caminho absoluto da raiz do repositório second-brain.

SECOND_BRAIN_ROOT=

# Preenchidos pelo bootstrap (SO detetado)
# SB_OS_FAMILY=
# SB_OS_DISPLAY=

# 1 = o hub lança Claude/Cursor via sudo como utilizadores dedicados (sbclaude/sbcursor).
# Requer: sudo bash scripts/os/agent-users/install-agent-users.sh (ou ./second-brain --setup).
SB_USE_AGENT_USERS=0

# Opcional: renomear contas criadas por install-agent-users.sh
# SB_AGENT_USER_CLAUDE=sbclaude
# SB_AGENT_USER_CURSOR=sbcursor
